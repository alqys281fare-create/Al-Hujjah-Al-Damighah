{
  "name": "legal-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "json-server --watch db.json --port 3001",
    "seed": "node scripts/seed.mjs",
    "build": "vite build",
    "server:prod": "json-server db.json --host 0.0.0.0 --port 3001",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.72.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "json-server": "0.17.4",
    "vite": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}